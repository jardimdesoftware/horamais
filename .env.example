# Portas mapeadas para o host
PORT_MACHINE_FRONTEND=3000
PORT_MACHINE_BACKEND=5000
PORT_MACHINE_DB=5432

# Registry de producao
# O workflow publica as imagens no GHCR do dono atual do repositorio.
GHCR_OWNER=jardimdesoftware

# Banco de dados
POSTGRES_USER=seu_usuario
POSTGRES_PASSWORD=sua_senha
POSTGRES_DB=horas_discentes_db
DATABASE_URL=Host=db;Port=5432;Database=horas_discentes_db;Username=seu_usuario;Password=sua_senha

# Frontend
# Em producao, deixe vazio para o browser usar /api na mesma origem.
# INTERNAL_API_URL é usada pelo NextAuth dentro do container do frontend.
# No docker-compose padrão, mantenha apontando para o serviço backend.
INTERNAL_API_URL=http://backend:5000/api
NEXT_PUBLIC_API_URL=
NEXTAUTH_SECRET=gere_com_openssl_rand_base64_32
NEXTAUTH_URL=https://seu-dominio.com.br

# CORS (origens autorizadas a chamar a API pelo browser)
# Use a URL pública do frontend. Aceita múltiplas origens separadas por vírgula.
# Em produção SEMPRE defina este valor; sem ele, requisições cross-origin são bloqueadas.
CORS_ALLOWED_ORIGIN=https://seu-dominio.com.br

# JWT
JWT__Key=chave_jwt_minimo_32_caracteres
JWT__Issuer=HoraMais
JWT__Audience=HoraMaisUsuarios

# Admin padrão (criado no primeiro boot)
ADMIN_EMAIL=admin@ifpe.edu.br
ADMIN_PASSWORD=Admin@1234

# Coordenador/curso inicial
# Consumidas pelo CoordenadorSeeder no primeiro boot. Em produção, defina estes
# valores quando quiser criar automaticamente o coordenador e o curso inicial.
COORD_EMAIL=coordenador@exemplo.com
COORD_PASSWORD=Coordenador@1234
COORD_NOME=Nome do Coordenador
COORD_PORTARIA=123/2026
COORD_DOU=2024-04-09
CURSO_NOME=Engenharia de Software
CURSO_MAX_HORAS_COMPLEMENTAR=120

# E-mail (SMTP)
EMAIL__Remetente=seu_email@gmail.com
EMAIL__Senha=sua_senha_de_aplicativo_gmail
EMAIL__Smtp=smtp.gmail.com
EMAIL__Porta=587

# E-mail da secretaria (recebe a notificação quando um aluno conclui a carga exigida)
SECRETARIA_EMAIL=secretaria@ifpe.edu.br

# Link de convite para coordenadores
# Em produção usar a URL pública
COORDENADOR_CONVITE_LINK=https://seu-dominio.com.br/criarContaCoordenador

# MinIO (armazenamento de anexos/certificados)
MINIO_ROOT_USER=usuario_minio_seguro
MINIO_ROOT_PASSWORD=senha_minio_minimo_8_chars
