[Unit]
Description=Atualizar Hora Mais com imagens aprovadas da main
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
SupplementaryGroups=docker
WorkingDirectory=/home/ubuntu/horamais
ExecStart=/usr/bin/bash /home/ubuntu/horamais/scripts/deploy/poll-vm.sh
TimeoutStartSec=15min
